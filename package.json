{
  "name": "@adamhl8/eslint-plugin-clean-modules",
  "version": "0.1.6",
  "description": "oxlint/ESLint plugin: require subpath imports, direct exports, and explicit import extensions",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "esm",
    "lint",
    "oxlint",
    "oxlint-plugin",
    "subpath-imports"
  ],
  "homepage": "https://github.com/adamhl8/eslint-plugin-clean-modules",
  "bugs": {
    "url": "https://github.com/adamhl8/eslint-plugin-clean-modules/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Adam Langbert",
    "email": "adamhl@pm.me",
    "url": "https://github.com/adamhl8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamhl8/eslint-plugin-clean-modules.git"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "bask prepare"
  },
  "dependencies": {
    "@typescript-eslint/types": "^8.72.1",
    "@typescript-eslint/utils": "^8.72.1"
  },
  "devDependencies": {
    "@adamhl8/bask": "^0.6.0",
    "@adamhl8/configs": "^3.4.1",
    "@arethetypeswrong/core": "^0.18.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/bun": "^1.4.4",
    "@typescript-eslint/rule-tester": "^8.72.1",
    "eslint": "^10.13.0",
    "knip": "^6.43.0",
    "markdown-toc": "^1.2.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "publint": "^0.3.25",
    "release-it": "^21.1.1",
    "release-it-git-cliff": "^0.2.0",
    "tsdown": "^0.23.2",
    "typescript": "^6.0.3",
    "typescript-next": "npm:typescript@^7.1.0-beta"
  },
  "engines": {
    "node": ">=24"
  }
}
