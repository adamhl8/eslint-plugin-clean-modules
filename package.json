{
  "name": "@adamhl8/eslint-plugin-clean-modules",
  "version": "0.1.5",
  "description": "oxlint/ESLint plugin: require subpath imports, direct exports, and explicit import extensions",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "lint",
    "oxlint",
    "subpath-imports"
  ],
  "homepage": "https://github.com/adamhl8/eslint-plugin-clean-modules",
  "bugs": {
    "url": "https://github.com/adamhl8/eslint-plugin-clean-modules/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Adam Langbert",
    "email": "adamhl@pm.me",
    "url": "https://github.com/adamhl8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamhl8/eslint-plugin-clean-modules.git"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "just prepare"
  },
  "dependencies": {
    "@typescript-eslint/types": "^8.70.1",
    "@typescript-eslint/utils": "^8.70.1"
  },
  "devDependencies": {
    "@adamhl8/configs": "^2.8.1",
    "@arethetypeswrong/core": "^0.18.5",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/bun": "^1.4.2",
    "@typescript-eslint/rule-tester": "^8.70.1",
    "@typescript/native-preview": "npm:typescript@^7.0.2",
    "eslint": "^10.11.0",
    "knip": "^6.38.0",
    "markdown-toc": "^1.2.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "publint": "^0.3.24",
    "release-it": "^21.1.0",
    "tsdown": "^0.23.0",
    "typescript": "npm:typescript@^6.0.3"
  }
}
