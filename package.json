{
  "name": "@adamhl8/eslint-plugin-clean-modules",
  "version": "0.1.4",
  "description": "oxlint/ESLint plugin: require subpath imports, direct exports, and explicit import extensions",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "lint",
    "oxlint",
    "subpath-imports"
  ],
  "homepage": "https://github.com/adamhl8/eslint-plugin-clean-modules",
  "bugs": {
    "url": "https://github.com/adamhl8/eslint-plugin-clean-modules/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Adam Langbert",
    "email": "adamhl@pm.me",
    "url": "https://github.com/adamhl8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamhl8/eslint-plugin-clean-modules.git"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "just prepare"
  },
  "dependencies": {
    "@typescript-eslint/types": "^8.63.0",
    "@typescript-eslint/utils": "^8.63.0"
  },
  "devDependencies": {
    "@adamhl8/configs": "^0.36.0",
    "@arethetypeswrong/core": "^0.18.4",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.1.0",
    "@typescript-eslint/rule-tester": "^8.63.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.6.0",
    "knip": "^6.24.0",
    "markdown-toc": "^1.2.0",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "oxlint-tsgolint": "^0.24.0",
    "publint": "^0.3.21",
    "release-it": "^20.2.1",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
